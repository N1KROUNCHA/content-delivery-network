# ==============================================================
# Environment Variables — Copy this file to .env and fill in
# your actual values. Never commit the .env file itself.
# ==============================================================

# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=your_strong_db_password_here

# ---------------------------------------------------------------
# AWS S3 — Used by content-service for file storage
# ---------------------------------------------------------------
AWS_S3_ACCESS_KEY=your_aws_access_key_id
AWS_S3_SECRET_KEY=your_aws_secret_access_key
AWS_S3_REGION=ap-south-2
AWS_S3_BUCKET_NAME=your-s3-bucket-name
# Leave empty to use real AWS S3; set to a MinIO endpoint for local dev
AWS_S3_ENDPOINT=

# ---------------------------------------------------------------
# Rate Limiting (gateway-service)
# ---------------------------------------------------------------
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10

# ---------------------------------------------------------------
# JWT Secret (used by pqc-common/JwtUtils)
# Update the hardcoded SECRET_STRING in JwtUtils.java for prod.
# ---------------------------------------------------------------
# JWT_SECRET=your-at-least-32-character-secret-key

# ---------------------------------------------------------------
# Keys (provided as mounted volume — see keys/)
# The keys/ directory must contain:
#   dilithium.priv  — Dilithium3 private signing key
#   dilithium.pub   — Dilithium3 public verification key
#
# Generate with:
#   mvn exec:java -Dexec.mainClass="com.cnslab.pqc.common.KeyGenTool"
# Or run the verification-service once in dev mode to auto-generate.
# ---------------------------------------------------------------
